<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estas tres sao o que faz existir o card na tela de bloqueio e na
         aba de notificacao. Nenhuma delas da acesso a rede: continua sem
         INTERNET, e essa ausencia continua sendo a prova de que e local.
         O servico em primeiro plano tambem e o que impede o Android de
         matar o processo quando a tela apaga e a musica pararia sozinha. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Vitrola"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/TemaVitrola"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ServicoMidia"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
